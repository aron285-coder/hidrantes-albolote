{
  "name": "hidrantes-albolote",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Mapa de hidrantes y bocas de riego de Protección Civil de Albolote",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "formato": "prettier --write .",
    "formato:comprobar": "prettier --check .",
    "test": "vitest run",
    "test:sql": "supabase test db",
    "e2e": "playwright test",
    "presupuesto": "tsx scripts/presupuesto.ts",
    "arranque": "tsx scripts/arranque.ts",
    "migrar": "tsx scripts/migrar.ts",
    "revertir": "tsx scripts/revertir.ts",
    "crear-issues": "tsx scripts/crear-issues.ts",
    "detectar-secretos": "tsx scripts/detectar-secretos.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "comprobar-despliegue": "tsx scripts/comprobar-despliegue.ts",
    "guarda-produccion": "tsx scripts/guarda-produccion.ts",
    "zona": "tsx scripts/generar-zona.ts",
    "cargar-zona": "tsx scripts/cargar-zona.ts",
    "respaldo-fotos": "tsx scripts/respaldo-fotos.ts",
    "restaurar": "tsx scripts/restaurar.ts",
    "restaurar-fotos": "tsx scripts/restaurar-fotos.ts",
    "asegurar-propietario": "tsx scripts/asegurar-propietario.ts",
    "probar-functions": "tsx scripts/probar-functions.ts",
    "intrusion": "tsx scripts/intrusion.ts",
    "compatibilidad": "tsx scripts/compatibilidad.ts",
    "capturas": "tsx scripts/capturas.ts",
    "promover-piloto": "tsx scripts/promover-piloto.ts",
    "functions:dev": "wrangler pages dev dist --port 8788 --ip 127.0.0.1 --compatibility-date=2026-09-01",
    "iconos": "tsx scripts/generar-iconos.ts",
    "mapabase": "tsx scripts/generar-mapabase.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "pmtiles": "^3.2.1",
    "protomaps-leaflet": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/bbox": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/truncate": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "openpgp": "^6.3.1",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
